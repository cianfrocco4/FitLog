// Copy to Secrets.release.xcconfig (gitignored) before archiving for App Store.
// Must match FITLOG_PROXY_SHARED_SECRET on Render when authRequired is true.
//
// cp Config/Secrets.release.xcconfig.example Config/Secrets.release.xcconfig
// Then set your secret below (prefer: openssl rand -hex 32).
// Never put a real secret in this .example file — it is committed to git.

FITLOG_PROXY_SHARED_SECRET =
